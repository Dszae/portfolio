{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  // Wraps .open-next/worker.js to cache optimized images; see cloudflare/worker.js.
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "issues": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "dipeshsapkota7.com.np",
      "custom_domain": true
    },
    {
      "pattern": "www.dipeshsapkota7.com.np",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "next-portfolio-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "next-portfolio-tags",
      "database_id": "f01bced8-6e8f-4641-b4d9-24775f434d01"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  // Non-production branch builds run `wrangler preview`, which requires this block.
  // Previews reuse the production R2 cache and D1 tag cache, matching `wrangler versions upload`.
  // R2 cache keys include the build ID, so previews cannot overwrite production entries.
  // Durable Objects and service bindings are not supported in Worker Previews.
  "previews": {
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "next-portfolio-cache"
      }
    ],
    "d1_databases": [
      {
        "binding": "NEXT_TAG_CACHE_D1",
        "database_name": "next-portfolio-tags",
        "database_id": "f01bced8-6e8f-4641-b4d9-24775f434d01"
      }
    ],
    "ai": {
      "binding": "AI"
    },
    "images": {
      "binding": "IMAGES"
    }
  }
}
