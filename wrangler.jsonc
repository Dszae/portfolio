{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "issues": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "dipeshsapkota7.com.np/*",
      "zone_name": "dipeshsapkota7.com.np"
    },
    {
      "pattern": "www.dipeshsapkota7.com.np/*",
      "zone_name": "dipeshsapkota7.com.np"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "next-portfolio-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "next-portfolio-tags",
      "database_id": "f01bced8-6e8f-4641-b4d9-24775f434d01"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
